{
  "name": "sidereal",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",

  "durable_objects": {
    "bindings": [{ "name": "SKY", "class_name": "Sky" }]
  },

  // `new_sqlite_classes`, not `new_classes`. The SQLite storage backend is the only one
  // available on the Workers Free plan, and the choice is made once at class creation and
  // cannot be changed afterwards - a class created with `new_classes` stays on the
  // key-value backend forever and simply will not run on a free account.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sky"] }],

  // The watchdog. One minute is cron's floor and also the longest a dead feed schedule
  // should stay dead. The real poll cadence is the object's alarm; see `src/worker/feeds.ts`.
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true },

  // The built page, served from the same origin as the socket.
  //
  // Same origin is the point, not a convenience. A page on one host opening a WebSocket to
  // another is a cross-origin upgrade, which means the room has to decide which origins may
  // connect, and a portfolio link that works everywhere except behind a strict proxy is worse
  // than one origin that always works.
  //
  // `run_worker_first` is false by default, so a request for a real file is served from the
  // asset store without waking the worker at all. The worker only sees /sky, /ingest, /stats
  // and /health, which is what keeps an idle visit costing nothing.
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }

  // No `vars` block on purpose. INGEST_TOKEN is a secret, not a var: a var is committed
  // plaintext in this file. `npx wrangler secret put INGEST_TOKEN`, and `.dev.vars` locally.
  //
  // The `assets` binding above serves ./dist, which `npm run build` writes. Deploying without
  // building first publishes whatever dist happened to contain, so build is part of deploy.
}
